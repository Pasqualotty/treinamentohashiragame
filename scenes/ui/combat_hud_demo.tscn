[node name="ResetBtn" type="Button" parent="DebugPanel/VBox/Row2"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "Reset"

[connection signal="pressed" from="DebugPanel/VBox/Row1/DmgBtn" to="." method="_on_dmg_pressed"]
