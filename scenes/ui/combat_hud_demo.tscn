grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="DebugPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="DebugPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.85, 1)
theme_override_font_sizes/font_size = 16
text = "…"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Row1" type="HBoxContainer" parent="DebugPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="DmgBtn" type="Button" parent="DebugPanel/VBox/Row1"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "HP -10"

[node name="HealBtn" type="Button" parent="DebugPanel/VBox/Row1"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "HP +15"

[node name="BreathBtn" type="Button" parent="DebugPanel/VBox/Row1"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "Breath +10"

[node name="Row2" type="HBoxContainer" parent="DebugPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
