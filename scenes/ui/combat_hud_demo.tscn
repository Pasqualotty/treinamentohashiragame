theme_override_font_sizes/font_size = 22
text = "Sandbox do HUD de combate
(sem player / hitbox / fase)"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CombatHud" parent="." instance=ExtResource("2_hud")]

[node name="DebugPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -420.0
offset_top = -160.0
offset_right = 420.0
offset_bottom = -16.0
