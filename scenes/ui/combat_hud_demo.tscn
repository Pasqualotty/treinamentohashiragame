[node name="UltBtn" type="Button" parent="DebugPanel/VBox/Row2"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "Fill / ULT"

[node name="CoinsBtn" type="Button" parent="DebugPanel/VBox/Row2"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
