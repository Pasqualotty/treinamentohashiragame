config_version=5

[application]

config/name="Treinamento Hashira"
config/description="Fan game 2D Demon Slayer â€” uso pessoal. Pasqualotti Studio."
config/version="0.0.1"
run/main_scene="res://scenes/boot/splash_studio.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

Palette="*res://scripts/autoload/palette.gd"
Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
CombatFeel="*res://scripts/combat/combat_feel.gd"
Fx="*res://scripts/autoload/fx.gd"
AutoUpdater="*res://scripts/autoload/auto_updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/theme/default_theme.tres"

